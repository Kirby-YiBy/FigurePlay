<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FigurePlay</AssemblyName>
    <RootNamespace>FigurePlay.SingleFile</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\figureplay.ico</ApplicationIcon>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <DebugType>embedded</DebugType>
    <Deterministic>true</Deterministic>
    <Version>1.4.2</Version>
    <FileVersion>1.4.2.0</FileVersion>
    <AssemblyVersion>1.4.2.0</AssemblyVersion>
    <AssemblyTitle>FigurePlay 桌面版（单文件）</AssemblyTitle>
    <Product>FigurePlay</Product>
    <Description>FigurePlay 论文子图排版桌面版单文件启动器（内嵌完整运行时与网页资源）</Description>
    <Company>FigurePlay</Company>
    <Copyright>Copyright © FigurePlay</Copyright>
    <NeutralLanguage>zh-Hans</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <!-- payload.zip 由 desktop\build.ps1 在发布前生成（包含 dist 全部内容）。
         直接编译本工程（没有 payload）不会失败，但运行时会提示缺少内嵌资源。 -->
    <EmbeddedResource Include="payload\payload.zip" LogicalName="FigurePlay.Payload.zip" Condition="Exists('payload\payload.zip')" />
  </ItemGroup>

</Project>
